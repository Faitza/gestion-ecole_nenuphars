# Copiez ce fichier en .env (il n'est jamais envoyé sur GitHub).
# En production, définissez les mêmes variables chez l'hébergeur.

# 1 en développement sur votre ordinateur, 0 en production
DJANGO_DEBUG=1

# Obligatoire en production. Générez-en une avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Noms de domaine du site, séparés par des virgules (ex. nenuphars.ht,www.nenuphars.ht)
DJANGO_ALLOWED_HOSTS=
# Adresses complètes en https, séparées par des virgules (ex. https://nenuphars.ht)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de données : sqlite (développement, rien à installer)
# ou postgresql (conseillé en production)
DB_ENGINE=sqlite
# Nom de la base (par défaut db.sqlite3 pour sqlite, gestion_ecole pour postgresql)
DB_NAME=
# Pour postgresql seulement :
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Dossier des photos (par défaut : media/ dans le projet). À sauvegarder avec la base.
DJANGO_MEDIA_ROOT=

# ─── Mise en ligne (voir docs/production.md) ───
# 1 chez un hébergeur qui transmet l'adresse du visiteur (Render, Railway, nginx...)
DJANGO_DERRIERE_UN_PROXY=0
# Adresses e-mail prévenues à chaque erreur du site, séparées par des virgules
DJANGO_ADMINS=
# Serveur d'envoi des e-mails (sans EMAIL_HOST, les e-mails restent dans la console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_EXPEDITEUR=
# Pages permises par minute pour un même visiteur (600 par défaut)
DJANGO_LIMITE_PAGES_PAR_MINUTE=
# Poids total d'un envoi de fichiers, en Mo (60 par défaut)
DJANGO_TAILLE_MAX_ENVOI_MO=
# Dossiers du journal des erreurs, de la mémoire du site et des sauvegardes
DJANGO_DOSSIER_JOURNAUX=
DJANGO_CACHE_DOSSIER=
DJANGO_DOSSIER_SAUVEGARDES=
# Facultatif : un serveur Redis pour la mémoire du site (ex. redis://localhost:6379/0)
DJANGO_CACHE_REDIS=
