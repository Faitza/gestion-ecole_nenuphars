# Copiez ce fichier en .env (il n'est jamais envoyé sur GitHub).
# En production, définissez les mêmes variables chez l'hébergeur.

# 1 en développement sur votre ordinateur, 0 en production
DJANGO_DEBUG=1

# Obligatoire en production. Générez-en une avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Noms de domaine du site, séparés par des virgules (ex. nenuphars.ht,www.nenuphars.ht)
DJANGO_ALLOWED_HOSTS=
# Adresses complètes en https, séparées par des virgules (ex. https://nenuphars.ht)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de données : sqlite (développement, rien à installer)
# ou postgresql (conseillé en production)
DB_ENGINE=sqlite
# Nom de la base (par défaut db.sqlite3 pour sqlite, gestion_ecole pour postgresql)
DB_NAME=
# Pour postgresql seulement :
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Dossier des photos (par défaut : media/ dans le projet). À sauvegarder avec la base.
DJANGO_MEDIA_ROOT=
